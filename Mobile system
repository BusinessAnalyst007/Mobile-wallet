def check_balance(balance):
    print(f"your balance is:{balance} ")
    return balance

def add_balance(balance):
  recharge = float(input("Please enter recharge amount: "))
  if recharge < 0:
    print("Invalid amount entered")
  else:
    balance += recharge
    print(f"recharge successful, balance is {balance}")
  return balance

def use_balance(balance):
  spent_balance = float(input("please enter your balance: "))
  if spent_balance > balance:
    print("Insufficient balance: ")
  elif spent_balance <= 0:
    print("invalid: ")
  else:
    balance -= spent_balance
    print("you recharge is completed")
  return balance


def change_number(reg_number):
    user_number = float(input("enter your existing reg number: "))
    if user_number == reg_number:
      new_number = float(input("Enter new number"))
      print(f"Reg number updated :{new_number}")
      return new_number
    else:
      print("kindly enter correct reg number")
    return reg_number
  
